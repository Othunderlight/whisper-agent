{
  "productName": "ryoiki-tenkai",
  "identifier": "com.ryoikitenkai.desktop",
  "mainBinaryName": "ryoiki-tenkai",
  "bundle": {
    "linux": {
      "deb": {
        "depends": [
          "libxdo3",
          "xdotool",
          "libvulkan1",
          "libgtk-layer-shell0",
          "wtype"
        ],
        "conflicts": [
          "ryoiki-tenkai-gpu"
        ],
        "replaces": [
          "ryoiki-tenkai-gpu"
        ]
      },
      "rpm": {
        "depends": [
          "xdotool",
          "vulkan-loader",
          "gtk-layer-shell",
          "wtype"
        ],
        "conflicts": [
          "ryoiki-tenkai-gpu"
        ],
        "obsoletes": [
          "ryoiki-tenkai-gpu"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ryoiki-tenkai/ryoiki-tenkai/releases/download/desktop-prod/latest.json"
      ]
    }
  }
}
